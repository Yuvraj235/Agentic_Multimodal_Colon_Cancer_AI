# Keep the Docker context small so HF Spaces builds quickly.
# The model checkpoint is downloaded from HF Hub at runtime; we don't
# need it in the image.

# Repository housekeeping
.git
.gitignore
.gitattributes
.claude
.streamlit/config.toml.local

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
venv
.venv
env

# Large data / outputs / experiments
data
experiments
paper_figures
notebooks

# Most of outputs/ is logs / figures / manifests we don't need in the
# image. But we DO need the v2 checkpoint + temperature so the app finds
# them at the expected path on first boot without runtime download.
outputs/*
!outputs/unified_multimodal_v2
outputs/unified_multimodal_v2/*
!outputs/unified_multimodal_v2/checkpoints
!outputs/unified_multimodal_v2/temperature.json
outputs/unified_multimodal_v2/checkpoints/*
!outputs/unified_multimodal_v2/checkpoints/best_model.pth

# Local-only model artefacts (already covered by the rules above, but
# kept as belt-and-braces for any other big binaries that might land).
*.pt
*.bin
*.safetensors

# Editor / OS
.DS_Store
.idea
.vscode
*.swp

# Docs that don't belong in the runtime image
*.tex
*.pdf
*.docx
RUN_ME.md
SECURITY.md
research_paper.tex
